{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Lets a file in src/lib import another with an explicit ".ts" extension.
    // `npm test` runs these files straight through node, which requires the extension on a
    // relative import; TypeScript forbids it unless this is on. Without it, any lib that imports
    // another lib simply cannot be unit-tested — which is why every tested file in src/lib until
    // now was either dependency-free or imported types only. Safe here because `noEmit` is set,
    // so nothing is ever emitted with a .ts specifier left in it. It permits the extension; it
    // does not require it, so no existing import changes.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "supabase/functions", "test", "e2e", "playwright.config.ts"]
}
