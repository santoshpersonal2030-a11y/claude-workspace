# Copy this file to ".env.local" and fill in your real values.
# ".env.local" is git-ignored and must NEVER be committed.

# Your Supabase project URL (safe to expose — it's public).
NEXT_PUBLIC_SUPABASE_URL=https://bimhdtkltoittqnxkesz.supabase.co

# Your Supabase PUBLISHABLE (anon) key. Safe to expose in the browser.
# Supabase -> Settings -> API -> Project API keys -> "anon / publishable".
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# NOTE: The SECRET (service_role) key is NOT used by the storefront and
# must never go in a NEXT_PUBLIC_ variable. We only add it later, server-side.

# ---- Optional: order confirmation emails (Resend) --------------------------
# Leave these blank and the store still works — it just won't send emails.
# To turn on: sign up at resend.com, verify a sending domain, then set:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RESEND_FROM=Online Pooja Stores <orders@yourdomain.com>
